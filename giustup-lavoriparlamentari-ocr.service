[Unit]
Description=OCR dei lavori parlamentari scansionati (indice solo)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/giustup-sync-lavoriparlamentari
ExecStart=/usr/bin/flock -n /run/lock/giustup-lavoriparlamentari-ocr.lock /usr/bin/python3 /opt/giustup-sync-lavoriparlamentari/lavoriparlamentari.py --ocr --massimo 1200
